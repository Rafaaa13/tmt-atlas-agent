  "research_prompts": [
    {"id":"company-snapshot","label":"公司快照","prompt":"请更新 {company} 最近一个报告期的经营变化，列出收入、核心业务、利润率、资本开支/现金流，并为每个数字附上来源。"},
    {"id":"cloud-compare","label":"云业务比较","prompt":"请比较 {company} 与同赛道公司在云业务收入增速、利润率、研发投入和资本开支上的差异，并标记不可比项。"},
    {"id":"sector-scan","label":"赛道扫描","prompt":"请扫描 {sector} 的公司，比较收入增速、利润率、研发费用率和资本开支，解释指标口径差异。"},
    {"id":"event-analysis","label":"事件影响分析","prompt":"请分析这条公告/新闻对 {company}、业务、指标和风险的可能影响，分别列出直接事实、推断和待验证问题。"},
    {"id":"memo","label":"研究备忘录","prompt":"请把当前工作区已确认的事实整理成一页研究简报，区分事实、计算、推断和待办问题。"},
    {"id":"latest-news","label":"最新资讯收集","prompt":"请扫描我已经授权的数据源，列出过去 7 天的新公告、财报、IR 新闻和研究线索，并按重要性排序；没有授权的数据源不得访问。"}
  ]
